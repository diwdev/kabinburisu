# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler Cloud (https://cloud.maptiler.com/account/keys/)
NEXT_PUBLIC_MAPTILER_KEY=

# อีเมล admin คนเดียวที่จัดการ allowlist หน่วยกู้ภัย (ดู PLAN.md §5)
ADMIN_EMAIL=

# Upstash Redis — ไม่ได้ใช้จริงใน MVP นี้ (แทนที่ด้วย Postgres token-bucket ใน
# supabase/migrations/0006_rate_limit.sql) เก็บ placeholder ไว้เผื่อย้ายกลับไปใช้ทีหลัง
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# เลือก tile provider ของแผนที่: maptiler (ค่าเริ่มต้น) หรือ pmtiles (ดู lib/mapConfig.ts)
MAP_TILE_SOURCE=maptiler

# ใช้เฉพาะตอน MAP_TILE_SOURCE=pmtiles — URL สาธารณะของไฟล์ .pmtiles (เช่นบน Cloudflare R2)
NEXT_PUBLIC_PMTILES_URL=
